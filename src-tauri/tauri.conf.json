{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zztodo",
  "version": "0.1.28",
  "identifier": "com.zztodo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zztodo",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/qxryz/zztodo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OUY0RjI0MUFEOEJGNjIKUldSaXY5Z2FKRStmcU40TXJaMmh4NC83YmltL25MMDZlbHRGR2ROeTF4Ym9HeTZPQUZBUEYzemYK"
    }
  }
}
